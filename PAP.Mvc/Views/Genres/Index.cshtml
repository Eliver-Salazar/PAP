@using System.Linq
@model IEnumerable<PAP.DataAccess.Genre>

@{
    ViewBag.Title = "Géneros";

    // Obtiene la operación y el género seleccionado por el controlador.
    string mode = ViewBag.Mode as string ?? "";
    var selected = ViewBag.SelectedGenre as PAP.DataAccess.Genre;
}

@* Encabezado con el botón de agregar a la derecha. *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Géneros</h2>

    <a href="@Url.Action("Index", "Genres", new { mode = "create" })"
       class="btn btn-primary">
        Agregar género
    </a>
</div>

@* Mensajes después de guardar o eliminar. *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["Error"]
    </div>
}

@* Crear y editar comparten este formulario dentro de Index. *@
@if (mode == "create" || mode == "edit")
{
    <div class="card mb-4">
        <div class="card-header">
            @(mode == "create" ? "Agregar género" : "Editar género")
        </div>

        <div class="card-body">
            @using (Html.BeginForm("Save", "Genres", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })

                <input type="hidden" name="Id" value="@selected.Id" />

                <div class="mb-3">
                    <label for="Name" class="form-label">Nombre</label>

                    @Html.TextBox(
                        "Name",
                        selected.Name,
                        new
                        {
                            @class = "form-control",
                            maxlength = "100",
                            required = "required"
                        })
                </div>

                <div class="mb-3">
                    <label for="Description" class="form-label">
                        Descripción
                    </label>

                    @Html.TextArea(
                        "Description",
                        selected.Description,
                        new
                        {
                            @class = "form-control",
                            maxlength = "500",
                            rows = "3"
                        })
                </div>

                <button type="submit" class="btn btn-success">
                    Guardar
                </button>

                <a href="@Url.Action("Index", "Genres")"
                   class="btn btn-secondary">
                    Cancelar
                </a>
            }
        </div>
    </div>
}

@* Muestra todos los campos del género seleccionado. *@
@if (mode == "details")
{
    <div class="card mb-4">
        <div class="card-header">Detalle del género</div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">@selected.Id</dd>

                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9">@selected.Name</dd>

                <dt class="col-sm-3">Descripción</dt>
                <dd class="col-sm-9" style="white-space: pre-wrap">@selected.Description</dd>
            </dl>

            <a href="@Url.Action("Index", "Genres")"
               class="btn btn-secondary">
                Volver
            </a>
        </div>
    </div>
}

@* Solicita confirmación antes de ejecutar la eliminación. *@
@if (mode == "delete")
{
    <div class="alert alert-warning">
        <p>¿Eliminar el género <strong>@selected.Name</strong>?</p>

        @using (Html.BeginForm("Delete", "Genres", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@selected.Id" />

            <button type="submit" class="btn btn-danger">
                Confirmar eliminación
            </button>

            <a href="@Url.Action("Index", "Genres")"
               class="btn btn-secondary">
                Cancelar
            </a>
        }
    </div>
}

@* Tabla principal con las acciones solicitadas a la derecha. *@
<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Editar</th>
                <th>Eliminar</th>
                <th>Detalle</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var genre in Model)
            {
                <tr>
                    <td>@genre.Id</td>
                    <td>@genre.Name</td>
                    <td>@genre.Description</td>

                    <td>
                        <a class="btn btn-warning btn-sm"
                           href="@Url.Action("Index", "Genres",
                               new { mode = "edit", id = genre.Id })">
                            Editar
                        </a>
                    </td>

                    <td>
                        <a class="btn btn-danger btn-sm"
                           href="@Url.Action("Index", "Genres",
                               new { mode = "delete", id = genre.Id })">
                            Eliminar
                        </a>
                    </td>

                    <td>
                        <a class="btn btn-info btn-sm"
                           href="@Url.Action("Index", "Genres",
                               new { mode = "details", id = genre.Id })">
                            Detalle
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Todavía no hay géneros registrados.</p>
}
