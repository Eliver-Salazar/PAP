@using System.Linq
@model IEnumerable<PAP.DataAccess.Role>

@{
    ViewBag.Title = "Roles";

    // Obtiene la operación y el registro seleccionado.
    string mode = ViewBag.Mode as string ?? "";
    var selected = ViewBag.SelectedRole as PAP.DataAccess.Role;
}

@* Encabezado y botón de agregar a la derecha. *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Roles</h2>

    <a href="@Url.Action("Index", "Roles", new { mode = "create" })"
       class="btn btn-primary">
        Agregar rol
    </a>
</div>

@* Mensajes del resultado de las operaciones. *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["Error"]
    </div>
}

@* Formulario compartido para crear y editar. *@
@if (mode == "create" || mode == "edit")
{
    <div class="card mb-4">
        <div class="card-header">
            @(mode == "create" ? "Agregar rol" : "Editar rol")
        </div>

        <div class="card-body">
            @using (Html.BeginForm("Save", "Roles", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })

                <input type="hidden" name="Id" value="@selected.Id" />

                <div class="mb-3">
                    <label for="Name" class="form-label">Nombre</label>

                    @Html.TextBox(
                        "Name",
                        selected.Name,
                        new
                        {
                            @class = "form-control",
                            maxlength = "50",
                            required = "required"
                        })
                </div>

                <button type="submit" class="btn btn-success">
                    Guardar
                </button>

                <a href="@Url.Action("Index", "Roles")"
                   class="btn btn-secondary">
                    Cancelar
                </a>
            }
        </div>
    </div>
}

@* Detalle completo del rol, aunque también aparezca en la tabla. *@
@if (mode == "details")
{
    <div class="card mb-4">
        <div class="card-header">Detalle del rol</div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">@selected.Id</dd>

                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9">@selected.Name</dd>
            </dl>

            <a href="@Url.Action("Index", "Roles")"
               class="btn btn-secondary">
                Volver
            </a>
        </div>
    </div>
}

@* Confirmación de eliminación dentro de la misma vista. *@
@if (mode == "delete")
{
    <div class="alert alert-warning">
        <p>¿Eliminar el rol <strong>@selected.Name</strong>?</p>

        @using (Html.BeginForm("Delete", "Roles", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@selected.Id" />

            <button type="submit" class="btn btn-danger">
                Confirmar eliminación
            </button>

            <a href="@Url.Action("Index", "Roles")"
               class="btn btn-secondary">
                Cancelar
            </a>
        }
    </div>
}

@* Tabla principal con las acciones a la derecha. *@
<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Editar</th>
                <th>Eliminar</th>
                <th>Detalle</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var role in Model)
            {
                <tr>
                    <td>@role.Id</td>
                    <td>@role.Name</td>

                    <td>
                        <a class="btn btn-warning btn-sm"
                           href="@Url.Action("Index", "Roles",
                               new { mode = "edit", id = role.Id })">
                            Editar
                        </a>
                    </td>

                    <td>
                        <a class="btn btn-danger btn-sm"
                           href="@Url.Action("Index", "Roles",
                               new { mode = "delete", id = role.Id })">
                            Eliminar
                        </a>
                    </td>

                    <td>
                        <a class="btn btn-info btn-sm"
                           href="@Url.Action("Index", "Roles",
                               new { mode = "details", id = role.Id })">
                            Detalle
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Todavía no hay roles registrados.</p>
}

